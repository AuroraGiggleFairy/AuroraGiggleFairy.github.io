<AGFVanillaPlus-SmeltingPlus>


	<!--3rd Forge Smelting Slot-->
		<!-- Window: header (~46) + 3x75 input slots -->
		<set xpath="/windows/window[@name='windowForgeInput']/@height">280</set>

		<!-- Outer border behind input + materials -->
		<set xpath="/windows/window[@name='windowForgeInput']/sprite[@name='backgroundMain']/@height">229</set>
		<setattribute xpath="/windows/window[@name='windowForgeInput']/sprite[@name='backgroundMain']" name="width">228</setattribute>

		<!-- Left: 3 smelting input slots -->
		<set xpath="/windows/window[@name='windowForgeInput']/rect[@name='content']/@height">228</set>
		<set xpath="/windows/window[@name='windowForgeInput']/rect[@name='content']/grid/@rows">3</set>

		<!-- Right: material reserves stretch with the taller window -->
		<set xpath="/windows/window[@name='windowForgeInput']/rect[@name='content2']/@height">224</set>
		<set xpath="/windows/window[@name='windowForgeInput']/rect[@name='content2']/grid/@cell_height">38</set>
		<setattribute xpath="/windows/window[@name='windowForgeInput']/rect[@name='content2']/sprite" name="pos">-1,0</setattribute>
		<setattribute xpath="/windows/window[@name='windowForgeInput']/rect[@name='content2']/sprite" name="width">149</setattribute>
		<setattribute xpath="/windows/window[@name='windowForgeInput']/rect[@name='content2']/sprite" name="height">225</setattribute>

		<!--numbered labels on the 3 slots-->
		<append xpath="/windows/window[@name='windowForgeInput']/rect[@name='content']">
			<label depth="10" pos="7,-13"  height="64" width="64" color="255,255,255,120" text="1" font_size="54" justify="center" />
			<label depth="10" pos="7,-88" height="64" width="64" color="255,255,255,120" text="2" font_size="54" justify="center" />
			<label depth="10" pos="7,-163" height="64" width="64" color="255,255,255,120" text="3" font_size="54" justify="center" />
		</append>


	<!-- Purple Book: zoomed Forged Ahead only (overview has no room). -->
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-PurpleBook')">

			<!-- Recenter zoomed Workstations so the taller side box fits. -->
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedWorkstations']/label[@name='checklistWorkstationsMagName']/@pos">207,-225</set>
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedWorkstations']/grid[@name='checklistWorkstationsTitle']/@pos">207,-255</set>
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedWorkstations']/grid[@name='checklistWorkstations']/@pos">507,-165</set>

			<!-- Standalone taller box: advanced smelting stacks unlock with crucible @ 75. -->
			<append xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedWorkstations']">
				<!-- Gap matches mag→grid (50). Vertically centered on the 5x100 unlock grid. -->
				<rect name="QSectionSmeltingPlusAdv" pos="1093,-305" width="134" height="220" depth="3">
					<sprite depth="1" name="backgroundSection" sprite="menu_empty3px" width="134" height="220" color="[darkGrey]" type="sliced" fillcenter="true" />
					<sprite depth="3" name="backgroundBorderSection" sprite="menu_empty3px" foregroundlayer="true" pos="0,0" width="134" height="220" color="[black]" type="sliced" fillcenter="false" />
					<filledsprite depth="2" name="yesUnlocked" color="75,140,75,255" globalopacity="false" pos="0,0" width="134" height="220" fillcenter="true" type="filled" fill="{cvar(craftingWorkstationsCheck75)}" />
					<sprite depth="3" name="backgroundBorder" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="[black]" type="sliced" fillcenter="false" />
					<sprite depth="2" name="background" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="156, 136, 103" type="sliced" fillcenter="true" />
					<label depth="3" name="checkunlock" pos="25,-15" pivot="center" width="50" height="30" justify="center" text="75" color="[black]" font_size="26" />
					<sprite name="itemIcon" depth="3" pos="42,-40" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="resourceScrapIron" color="247,115,7" tooltip_key="resourceScrapIronAdvSmelt" />
					<sprite name="itemtypeicon" depth="8" pos="42,-40" width="20" height="20" sprite="ui_game_symbol_forge" foregroundlayer="true" color="" />
					<sprite name="itemIcon" depth="3" pos="42,-100" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="resourceScrapBrass" color="247,115,7" tooltip_key="resourceScrapBrassAdvSmelt" />
					<sprite name="itemtypeicon" depth="8" pos="42,-100" width="20" height="20" sprite="ui_game_symbol_forge" foregroundlayer="true" color="" />
					<sprite name="itemIcon" depth="3" pos="42,-160" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="resourceScrapLead" color="247,115,7" tooltip_key="resourceScrapLeadAdvSmelt" />
					<sprite name="itemtypeicon" depth="8" pos="42,-160" width="20" height="20" sprite="ui_game_symbol_forge" foregroundlayer="true" color="" />
				</rect>
			</append>

		</if>
	</conditional>


</AGFVanillaPlus-SmeltingPlus>
