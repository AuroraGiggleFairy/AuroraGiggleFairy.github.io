<zzzAGF-Compatibilities>
	<!-- Outback VET compass markers. Same CVar gate and 25m range as AGF VET. Red = hostile, green = tame/hireable. -->
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-VisualEntityTracker')">
			<!-- Draw above restored compass chrome (center tick is depth 20; vanilla waypoints use 50). -->
			<append xpath="/nav_object_classes/nav_object_class[starts-with(@name,'AGF')]/compass_settings">
				<property name="depth_offset" value="50"/>
			</append>
			<append xpath="/nav_object_classes">
				<nav_object_class name="AGFAnimalOutbackHostile">
					<property name="requirement_type" value="CVar"/>
					<property name="requirement_name" value="agfVet"/>
					<compass_settings>
						<property name="sprite_name" value="ui_game_symbol_animal_tracker"/>
						<property name="min_distance" value="0"/>
						<property name="max_distance" value="25"/>
						<property name="color" value="255,0,0,255"/>
						<property name="has_pulse" value="true"/>
						<property name="icon_clamped" value="true"/>
						<property name="depth_offset" value="50"/>
					</compass_settings>
				</nav_object_class>
				<nav_object_class name="AGFAnimalOutbackKangaroo">
					<property name="requirement_type" value="CVar"/>
