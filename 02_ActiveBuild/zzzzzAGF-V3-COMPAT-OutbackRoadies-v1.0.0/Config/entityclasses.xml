<AGF-OutbackRoadies>
	<conditional>
		<if cond="mod_loaded('V3_OutbackRoadies')">
			<!-- Re-apply AGF bag size and starting carry without vanilla 45/27 filters (Outback's filtered xpath failed after AGF). -->
			<conditional>
				<if cond="mod_loaded('AGF-BackpackPlus-119Slots')">
					<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/triggered_effect[@cvar='.carryCapacityBase'][@operation='set']/@value">42</set>
					<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='BagSize']/@value">119</set>
				</if>
				<else>
					<conditional>
						<if cond="mod_loaded('AGF-BackpackPlus-084Slots')">
							<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/triggered_effect[@cvar='.carryCapacityBase'][@operation='set']/@value">36</set>
							<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='BagSize']/@value">84</set>
						</if>
						<else>
							<conditional>
								<if cond="mod_loaded('AGF-BackpackPlus-072Slots')">
									<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/triggered_effect[@cvar='.carryCapacityBase'][@operation='set']/@value">36</set>
									<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='BagSize']/@value">72</set>
								</if>
								<else>
									<conditional>
										<if cond="mod_loaded('AGF-BackpackPlus-060Slots')">
											<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/triggered_effect[@cvar='.carryCapacityBase'][@operation='set']/@value">30</set>
											<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='BagSize']/@value">60</set>
										</if>
									</conditional>
								</else>
							</conditional>
						</else>
					</conditional>
				</else>
			</conditional>

			<!-- VET tags vanilla entities by name. Outback-added animals/zombies have their own Tags and never got agfVet*. -->
			<conditional>
				<if cond="mod_loaded('AGF-2VisualEntityTracker')">
					<!-- Re-apply the 25m scanner. Outback's playerMale edits sit after VET; a missed onSelfEnteredGame leaves zero compass icons, including vanilla zombies. -->
					<append xpath="/entity_classes/entity_class[@name='playerMale']">
						<effect_group>
							<triggered_effect trigger="onSelfEnteredGame" action="AddBuff" target="self" buff="buffZAlert"/>
							<triggered_effect trigger="onSelfRespawn" action="AddBuff" target="self" buff="buffZAlert"/>
						</effect_group>
					</append>

					<!-- Species icons only. Remaining land wildlife stay on generic animal_tracker until discussed. -->
					<append xpath="/entity_classes/entity_class[@name='animalCassowary']/property[@name='Tags']/@value">,agfVetOutbackHostile</append>
					<append xpath="/entity_classes/entity_class[@name='animalTassydevil']/property[@name='Tags']/@value">,agfVetOutbackHostile</append>
