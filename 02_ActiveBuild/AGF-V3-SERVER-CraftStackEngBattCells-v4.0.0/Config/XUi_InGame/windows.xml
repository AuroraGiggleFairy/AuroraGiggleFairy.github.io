<AGFVanillaPlus-CraftStackEngBattCells>

	<conditional>
		<if cond="mod_loaded('AGF-2PurpleBook')">

			<!-- Overview: engine in the empty slot at Electrician 45. -->
			<append xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='allChecklists']/rect[@name='checklistElectrician']/rect[@name='Section2']">
				<sprite name="itemIcon" depth="3" pos="26,-85" size="21,21" foregroundlayer="true" atlas="ItemIconAtlas" sprite="smallEngine" color="" tooltip_key="smallEngine" />
			</append>

			<!-- Overview: battery in the empty slot at Electrician 55 (next to the drawbridge). -->
			<append xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='allChecklists']/rect[@name='checklistElectrician']/rect[@name='Section3']">
				<sprite name="itemIcon" depth="3" pos="26,-160" size="21,21" foregroundlayer="true" atlas="ItemIconAtlas" sprite="carBattery" color="" tooltip_key="carBattery" />
			</append>

			<!-- Overview: replace the quality ladder with a seeds-12-sized Solar Power box at 100. -->
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='allChecklists']/rect[@name='checklistElectrician']/@height">489</set>
			<remove xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='allChecklists']/rect[@name='checklistElectrician']/rect[@name='Section4']" />
			<insertafter xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='allChecklists']/rect[@name='checklistElectrician']/rect[@name='Section3']">
				<rect name="Section4" pos="0,-438" width="50" height="51">
					<sprite depth="1" name="backgroundSection" sprite="menu_empty3px" width="50" height="53" color="[darkGrey]" type="sliced" fillcenter="true" />
					<sprite depth="3" name="backgroundBorderSection" sprite="menu_empty3px" foregroundlayer="true" width="50" height="53" color="[black]" type="sliced" fillcenter="false" />
					<filledsprite depth="2" name="yesUnlocked" color="75,140,75,255" pos="0,0" width="50" height="51" fillcenter="true" type="filled" fill="{cvar(craftingElectricianCheck100)}" />
					<sprite depth="2" name="backgroundBorder" sprite="menu_empty3px" pos="2,-2" width="21" height="18" color="[black]" type="sliced" fillcenter="false" />
					<sprite depth="2" name="background" sprite="menu_empty3px" pos="3,-3" width="19" height="16" color="156, 136, 103" type="sliced" fillcenter="true" />
					<label depth="3" name="checkunlock" pos="0,-3" width="25" height="16" justify="center" text="100" color="[black]" font_size="16" />
					<sprite name="itemIcon" depth="3" pos="26,-5" size="21,21" foregroundlayer="true" atlas="ItemIconAtlas" sprite="solarbank" color="" tooltip_key="solarbank" />
					<sprite name="itemIcon" depth="3" pos="26,-25" size="21,21" foregroundlayer="true" atlas="ItemIconAtlas" sprite="solarCell" color="" tooltip_key="solarCell" />
				</rect>
			</insertafter>

			<!-- Zoomed 45: replace the box so both rows use the same 4-column X as level 25. -->
			<remove xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/rect[@name='QSection45']" />
			<insertafter xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/rect[@name='QSection25']">
				<rect name="QSection45" pos="0,-125" width="380" height="125">
					<sprite depth="1" name="backgroundSection" sprite="menu_empty3px" width="380" height="125" color="[darkGrey]" type="sliced" fillcenter="true" />
					<sprite depth="3" name="backgroundBorderSection" sprite="menu_empty3px" foregroundlayer="true" pos="0,0" width="380" height="125" color="[black]" type="sliced" fillcenter="false" />
					<filledsprite depth="2" name="yesUnlocked" color="75,140,75,255" pos="0,0" width="380" height="125" fillcenter="true" type="filled" fill="{cvar(craftingElectricianCheck45)}" />
					<sprite depth="3" name="backgroundBorder" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="[black]" type="sliced" fillcenter="false" />
					<sprite depth="2" name="background" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="156, 136, 103" type="sliced" fillcenter="true" />
					<label depth="3" name="checkunlock" pos="25,-15" pivot="center" width="50" height="30" justify="center" text="45" color="[black]" font_size="26" />
					<sprite name="itemIcon" depth="3" pos="103,-8" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="motionsensor" color="" tooltip_key="motionsensor" />
					<sprite name="itemIcon" depth="3" pos="161,-8" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="electrictimerrelay" color="" tooltip_key="electrictimerrelay" />
					<sprite name="itemIcon" depth="3" pos="219,-8" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="pressureplate" color="" tooltip_key="pressureplate" />
					<sprite name="itemIcon" depth="3" pos="277,-8" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="pressureplateLong" color="" tooltip_key="pressureplateLong" />
					<sprite name="itemIcon" depth="3" pos="103,-66" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="spotlightPlayer" color="" tooltip_key="spotlightPlayer" />
					<sprite name="itemIcon" depth="3" pos="161,-66" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="speaker" color="" tooltip_key="speaker" />
					<sprite name="itemIcon" depth="3" pos="219,-66" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="smallEngine" color="" tooltip_key="smallEngine" />
				</rect>
			</insertafter>

			<!-- Zoomed 55: battery in the empty strip under the 55 label, left of the original 4x3. Do not shift the grid. -->
			<insertbefore xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/rect[@name='QSection55']/sprite[@sprite='woodenGarageDoor4x3White']">
				<sprite name="itemIcon" depth="3" pos="1,-66" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="carBattery" color="" tooltip_key="carBattery" />
			</insertbefore>

			<!-- Zoomed: recenter the taller middle column, drop the quality ladder, add a centered 100 row. -->
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/@pos">565,-178</set>
			<set xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/@height">475</set>
			<remove xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/rect[@name='QSectionTier6Vertical']" />
			<insertafter xpath="/windows/window[@name='Schematics']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='craftinglistTab']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='zoomedElectrician']/rect[@name='checklistElectrician']/rect[@name='QSection55']">
				<rect name="QSection100" pos="0,-375" width="380" height="100">
					<sprite depth="1" name="backgroundSection" sprite="menu_empty3px" width="380" height="100" color="[darkGrey]" type="sliced" fillcenter="true" />
					<sprite depth="3" name="backgroundBorderSection" sprite="menu_empty3px" foregroundlayer="true" pos="0,0" width="380" height="100" color="[black]" type="sliced" fillcenter="false" />
					<filledsprite depth="2" name="yesUnlocked" color="75,140,75,255" pos="0,0" width="380" height="100" fillcenter="true" type="filled" fill="{cvar(craftingElectricianCheck100)}" />
					<sprite depth="3" name="backgroundBorder" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="[black]" type="sliced" fillcenter="false" />
					<sprite depth="2" name="background" sprite="menu_empty3px" pos="0,0" width="50" height="30" color="156, 136, 103" type="sliced" fillcenter="true" />
					<label depth="3" name="checkunlock" pos="25,-15" pivot="center" width="50" height="30" justify="center" text="100" color="[black]" font_size="26" />
					<sprite name="itemIcon" depth="3" pos="136,-40" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="solarbank" color="" tooltip_key="solarbank" />
					<sprite name="itemIcon" depth="3" pos="194,-40" size="50,50" foregroundlayer="true" atlas="ItemIconAtlas" sprite="solarCell" color="" tooltip_key="solarCell" />
				</rect>
			</insertafter>

		</if>
	</conditional>

</AGFVanillaPlus-CraftStackEngBattCells>
