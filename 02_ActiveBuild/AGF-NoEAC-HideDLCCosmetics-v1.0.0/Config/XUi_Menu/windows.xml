							<options_combo_custom name="DesertSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcDesertSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcDesertSetTooltip" width="1000"/>
							<options_combo_custom name="HellreaverSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcHellreaverSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcHellreaverSetTooltip" width="1000"/>
							<options_combo_custom name="HoarderSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcHoarderSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcHoarderSetTooltip" width="1000"/>
							<options_combo_custom name="HolidayHatsSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcHolidayHatsSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcHolidayHatsSetTooltip" width="1000"/>
							<options_combo_custom name="PirateSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcPirateSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcPirateSetTooltip" width="1000"/>
							<options_combo_custom name="MarauderSet" name_localization_prefix="xuiOptionsGeneralHideDlc" prefname="HideDlcMarauderSet" type="ComboBoxList`1[System.String]" values="Show,Hide" localization_prefix="xuiOptionsGeneralHideDlcValue" value_wrap="false" tooltip_key="xuiOptionsGeneralHideDlcMarauderSetTooltip" width="1000"/>
						</grid>
					</rect>
				</scrollview>
			</rect>
		</rect>
	</insertAfter>
</AGF-HideDLCCosmetics>
