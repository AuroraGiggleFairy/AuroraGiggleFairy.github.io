<AGFNoEAC-SmeltTimerTotal>

	<!-- Taller one-row strip under Smelting header. Own bordered box; Harmony shifts capacity below it. -->
	<insertafter xpath="/windows/window[@name='windowForgeInput']/rect[contains(@style,'header.panel')]">
		<rect name="smeltTimerModeBar" depth="5" pos="0,-46" width="228" height="32" controller="SmeltTimerModeBar, SmeltTimerTotal">
			<sprite depth="1" name="modeBarBg" sprite="menu_empty3px" color="[darkGrey]" type="sliced" fillcenter="true" width="228" height="32" />
			<sprite depth="2" name="modeBarBorder" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="228" height="32" foregroundlayer="true" />

			<sprite depth="3" name="modeBarClock" width="22" height="22" pos="6,-5"
				sprite="ui_game_symbol_clock" color="[beige]" foregroundlayer="true"
				tooltip_key="xuiSmeltTimerClockTooltip" />

			<simplebutton name="btnSmeltTimerSingle" depth="3" pos="34,-5" width="94" height="22" font_size="16"
				caption_key="xuiSmeltTimerSingle" tooltip_key="xuiSmeltTimerSingleTooltip"
				bordercolor="12,12,12" defaultcolor="58,58,58" selectedsprite="menu_empty" selectedcolor="74,33,150"
				foregroundlayer="false" selected="{smelttimer_single_selected}" sound="[paging_click]" />

			<simplebutton name="btnSmeltTimerTotal" depth="3" pos="130,-5" width="94" height="22" font_size="16"
				caption_key="xuiSmeltTimerTotal" tooltip_key="xuiSmeltTimerTotalTooltip"
				bordercolor="12,12,12" defaultcolor="58,58,58" selectedsprite="menu_empty" selectedcolor="74,33,150"
				foregroundlayer="false" selected="{smelttimer_total_selected}" sound="[paging_click]" />
		</rect>
	</insertafter>

</AGFNoEAC-SmeltTimerTotal>
