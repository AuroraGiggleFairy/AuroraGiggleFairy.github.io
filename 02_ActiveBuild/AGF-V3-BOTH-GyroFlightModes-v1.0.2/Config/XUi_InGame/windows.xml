<AGF-GyroFlightModes>
	<append xpath="/windows/window[@name='windowVehicle']/rect[@name='content']/rect">
		<rect name="flightModeRow" depth="3" pos="0,-276" height="33" visible="false">
			<sprite depth="8" sprite="menu_empty3px" height="33" color="[black]" type="sliced" fillcenter="false" />
			<sprite depth="1" color="[darkGrey]" type="sliced" />
			<label depth="3" pos="15,-3" width="140" height="28" font_size="26" text_key="xuiAGFFlightMode" justify="left" color="[white]" />
			<simplebutton name="btnFlightModeOriginal" depth="4" pos="155,-4" width="102" height="26" font_size="18"
				caption_key="xuiAGFFlightModeOriginal" tooltip_key="xuiAGFFlightModeOriginalTooltip"
				bordercolor="[black]" defaultcolor="[mediumGrey]" selectedsprite="menu_empty" selectedcolor="74, 33, 150"
				foregroundlayer="true" selected="{agfflightmodeoriginalselected}" sound="[paging_click]" />
			<simplebutton name="btnFlightModeHeli" depth="4" pos="260,-4" width="110" height="26" font_size="18"
				caption_key="xuiAGFFlightModeHeli" tooltip_key="xuiAGFFlightModeHeliTooltip"
				bordercolor="[black]" defaultcolor="[mediumGrey]" selectedsprite="menu_empty" selectedcolor="74, 33, 150"
				foregroundlayer="true" selected="{agfflightmodeheliselected}" sound="[paging_click]" />
		</rect>
	</append>

	<remove xpath="/windows/window[@name='windowRadial']/label[@name='selection']"/>
	<append xpath="/windows/window[@name='windowRadial']">
		<label depth="10" name="selection" width="240" height="40" pos="0,0" pivot="center" justify="center" text=" " font_size="28" color="[white]" effect="outline" effect_distance="1,1" effect_color="0,0,0,230" foregroundlayer="true"/>
		<label depth="10" name="selectionSub" width="240" height="24" pos="0,-28" pivot="center" justify="center" text="" font_size="22" color="[selectedColor]" effect="outline" effect_distance="1,1" effect_color="0,0,0,230" foregroundlayer="true"/>
	</append>
</AGF-GyroFlightModes>
