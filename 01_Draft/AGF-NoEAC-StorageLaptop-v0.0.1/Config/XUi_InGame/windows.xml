<AGF-StorageLaptop>
	<append xpath="/windows">
		<window name="windowStorageLaptop" width="645" height="803" panel="Left" cursor_area="true">
			<rect name="header" height="43" depth="1">
				<headerbg />
				<sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_computer" />
				<label style="header.name" pos="42,-6" width="400" text_key="cntStorageLaptop" />
			</rect>
			<rect name="content" pos="0,-43" width="645" height="760" depth="1">
				<boxbg backcolor="18,18,18,235" globalopacity="false" />

				<rect depth="2" name="categorySelector" width="645" height="44" pos="0,-6">
					<sprite depth="1" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="645" height="49" color="0,0,0,255" type="sliced" fillcenter="false" />
					<sprite depth="2" pos="3,0" color="96,96,96,245" type="sliced" width="639" height="44" globalopacity="false" />
					<button name="catAll" depth="4" style="icon30px, press" pos="23,-22" sprite="ui_game_symbol_shopping_cart" pivot="center" tooltip_key="lblAll" />
					<button name="catReading" depth="4" style="icon30px, press" pos="66,-22" sprite="ui_game_symbol_book" pivot="center" tooltip_key="lblCategoryReading" />
					<button name="catResources" depth="4" style="icon30px, press" pos="109,-22" sprite="ui_game_symbol_resource" pivot="center" tooltip_key="lblCategoryResources" />
					<button name="catAmmoWeapons" depth="4" style="icon30px, press" pos="152,-22" sprite="ui_game_symbol_knife" pivot="center" tooltip_key="lblCategoryAmmoWeapons" />
					<button name="catTools" depth="4" style="icon30px, press" pos="195,-22" sprite="ui_game_symbol_tool" pivot="center" tooltip_key="lblCategoryToolsTraps" />
					<button name="catScience" depth="4" style="icon30px, press" pos="238,-22" sprite="ui_game_symbol_science" pivot="center" tooltip_key="lblCategoryScience" />
					<button name="catMods" depth="4" style="icon30px, press" pos="281,-22" sprite="ui_game_symbol_assemble" pivot="center" tooltip_key="lblCategoryMods" />
					<button name="catFood" depth="4" style="icon30px, press" pos="324,-22" sprite="ui_game_symbol_fork" pivot="center" tooltip_key="lblCategoryFoodCooking" />
					<button name="catDecor" depth="4" style="icon30px, press" pos="367,-22" sprite="ui_game_symbol_chair" pivot="center" tooltip_key="lblCategoryDecorMisc" />
					<button name="catMedical" depth="4" style="icon30px, press" pos="410,-22" sprite="ui_game_symbol_medical" pivot="center" tooltip_key="lblCategoryMedicine" />
					<button name="catArmor" depth="4" style="icon30px, press" pos="453,-22" sprite="ui_game_symbol_armor_iron" pivot="center" tooltip_key="lblCategoryArmor" />
				</rect>

				<rect depth="3" name="searchControls" width="645" height="44" pos="0,-52">
					<sprite depth="1" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="645" height="49" color="0,0,0,255" type="sliced" fillcenter="false" />
					<sprite depth="2" pos="3,0" color="64,64,64,255" type="sliced" width="639" height="44" globalopacity="false" />
					<sprite depth="5" name="searchIcon" style="icon30px" pos="8,-7" sprite="ui_game_symbol_search" />
					<textfield name="searchInput" depth="6" pos="42,-6" width="590" height="32" backgroundcolor="0,0,0,255" justify="left" search_field="true" clear_button="true" close_group_on_tab="true" virtual_keyboard_prompt="vkPromptSearchTerm" />
				</rect>

				<rect name="tableHeader" pos="0,-98" width="645" height="43">
					<sprite depth="1" name="background" pos="3,0" width="639" height="40" color="128,128,128,245" type="sliced" globalopacity="false" />
					<rect depth="1" pos="0,0" width="361" height="40">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="361" height="46" color="0,0,0,255" type="sliced" fillcenter="false" />
						<sprite depth="1" pos="8,-6" width="28" height="28" sprite="ui_game_symbol_backpack" />
						<label depth="1" pos="40,-6" width="240" height="28" text_key="agfStorageLaptopSortName" />
					</rect>
					<rect depth="1" pos="358,0" width="126" height="40">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="126" height="46" color="0,0,0,255" type="sliced" fillcenter="false" />
						<sprite depth="1" pos="13,-6" width="28" height="28" sprite="ui_game_symbol_diamond" />
						<label depth="1" pos="45,-6" width="68" height="28" justify="left" text_key="agfStorageLaptopSortQuality" />
					</rect>
					<rect depth="1" pos="481,0" width="147" height="40">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="147" height="46" color="0,0,0,255" type="sliced" fillcenter="false" />
						<sprite depth="1" pos="17,-6" width="28" height="28" sprite="ui_game_symbol_loot_sack" />
						<label depth="1" pos="49,-6" width="82" height="28" justify="left" text_key="agfStorageLaptopAmount" />
					</rect>
					<rect depth="1" pos="625,0" width="20" height="40">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" pos="0,3" width="20" height="46" color="0,0,0,255" type="sliced" fillcenter="false" />
					</rect>
				</rect>

				<rect name="list" pos="0,-141" width="645" height="619" on_scroll="true">
					<sprite depth="1" name="listFill" pos="0,0" width="624" height="619" color="28,28,28,255" type="sliced" sprite="menu_empty" fillcenter="true" globalopacity="false" />
					<sprite depth="2" name="listBorder" pos="0,0" width="645" height="619" sprite="menu_empty3px" color="0,0,0,255" type="sliced" fillcenter="false" />
					<grid name="rows" rows="13" cols="1" pos="3,-8" cell_width="622" cell_height="47" repeat_content="true" arrangement="vertical">
						<rect name="row" width="622" height="47" controller="StorageLaptop.StorageLaptopRow, StorageLaptop" on_scroll="true">
							<sprite depth="1" name="background" color="40,40,40,255" type="sliced" sprite="menu_empty" fillcenter="true" width="622" height="47" on_press="true" on_hover="true" on_scroll="true" globalopacity="false" />
							<sprite depth="4" name="icon" pos="34,-23" width="38" height="38" pivot="center" atlas="ItemIconAtlas" foregroundlayer="true" />
							<sprite depth="8" name="typeIcon" pos="2,-2" width="12" height="12" foregroundlayer="true" visible="false" />
							<label depth="4" name="itemName" pos="61,-24" width="270" height="40" font_size="28" justify="left" pivot="left" overflow="shrinkcontent" max_line_count="1" />
							<label depth="4" name="chestName" pos="61,-28" width="270" height="16" font_size="16" justify="left" color="176,176,176" visible="false" />
							<sprite depth="5" name="lockIcon" pos="332,-12" width="22" height="22" sprite="ui_game_symbol_lock" visible="false" />
							<label depth="4" name="itemQuality" pos="358,-6" width="120" height="28" font_size="28" justify="center" color="230,230,230" />
							<sprite depth="5" name="durabilityBg" pos="393,-36" width="50" height="6" sprite="menu_empty3px" color="100,0,0,255" type="sliced" visible="false" />
							<sprite depth="6" name="durabilityFill" pos="393,-36" width="50" height="6" sprite="menu_empty3px" color="40,180,60,255" type="filled" fill="1" visible="false" />
							<label depth="4" name="itemCount" pos="486,-8" width="130" height="30" font_size="28" justify="center" />
						</rect>
					</grid>
				</rect>
				<label name="emptyLabel" depth="6" pos="314,-451" width="500" height="40" font_size="24" justify="center" pivot="center" color="176,176,176" text_key="agfStorageLaptopEmpty" />

				<rect name="scrollColumn" pos="624,-144" width="18" height="616">
					<sprite depth="2" name="scrollBack" pos="0,0" width="18" height="616" color="72,72,72,255" type="sliced" globalopacity="false" />
					<button name="scrollUp" depth="5" pos="9,-11" width="16" height="16" sprite="ui_game_symbol_arrow_left" rotation="-90" pivot="center" style="press" />
					<rect name="scrollTrack" pos="3,-24" width="12" height="568">
						<sprite depth="3" name="scrollTrackBg" width="12" height="568" color="72,72,72,255" type="sliced" sprite="menu_empty" fillcenter="true" on_press="true" on_scroll="true" globalopacity="false" />
						<sprite depth="4" name="scrollThumb" pos="1,0" width="10" height="36" pivot="topleft" color="230,230,230,255" type="sliced" sprite="menu_empty" fillcenter="true" on_press="true" on_drag="true" on_scroll="true" />
					</rect>
					<button name="scrollDown" depth="5" pos="9,-605" width="16" height="16" sprite="ui_game_symbol_arrow_right" rotation="-90" pivot="center" style="press" />
				</rect>

			</rect>
			<rect name="laptopUseStack" pos="-300,0" width="10" height="10" controller="ItemStack" visible="false">
				<sprite depth="1" name="itemIcon" width="10" height="10" />
			</rect>
		</window>
	</append>
	<append xpath="/windows/window[@name='itemInfoPanel']/rect[@name='contentInfo']">
		<rect name="laptopTransfer" pos="150,0" width="453" height="270" visible="false">
			<sprite depth="30" name="transferFrame" width="453" height="270" sprite="menu_empty" type="sliced" fillcenter="true" color="0,0,0,255" globalopacity="false" globalopacitymod="0" />
			<sprite depth="31" name="transferFill" pos="3,-3" width="447" height="264" sprite="menu_empty" type="sliced" fillcenter="true" color="56,56,56,255" globalopacity="false" globalopacitymod="0" />
			<rect name="transferControls" pos="54,-47" width="346" height="176">
				<simplebutton name="takeMin" depth="32" foregroundlayer="true" pos="0,0" width="32" height="32" font_size="16" caption="&lt;&lt;" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="takeDown" depth="32" foregroundlayer="true" pos="36,0" width="32" height="32" font_size="18" caption="&lt;" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<textfield name="takeAmountInput" depth="32" pos="72,0" width="52" height="32" character_limit="6" validation="integer" backgroundcolor="0,0,0,255" />
				<rect name="takeScale" pos="130,0" width="142" height="32">
					<sprite depth="32" name="takeTrack" pos="0,-12" width="142" height="8" color="16,16,16,255" type="sliced" sprite="menu_empty" fillcenter="true" on_press="true" globalopacity="false" globalopacitymod="0" />
					<sprite depth="33" name="takeThumb" pos="0,-6" width="16" height="20" pivot="topleft" color="210,210,210,255" type="sliced" sprite="menu_empty" fillcenter="true" on_press="true" on_drag="true" globalopacity="false" globalopacitymod="0" />
				</rect>
				<simplebutton name="takeUp" depth="32" foregroundlayer="true" pos="278,0" width="32" height="32" font_size="18" caption="&gt;" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="takeMax" depth="32" foregroundlayer="true" pos="314,0" width="32" height="32" font_size="16" caption="&gt;&gt;" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="transferCancel" depth="32" foregroundlayer="true" pos="71,-48" width="96" height="32" font_size="22" caption_key="agfStorageLaptopCancel" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="transferTake" depth="32" foregroundlayer="true" pos="179,-48" width="96" height="32" font_size="22" caption_key="agfStorageLaptopTake" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="transferTakeAll" depth="32" foregroundlayer="true" pos="0,-144" width="167" height="32" font_size="22" caption_key="btnTakeAll" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
				<simplebutton name="transferTakeAllButOne" depth="32" foregroundlayer="true" pos="179,-144" width="167" height="32" font_size="22" caption_key="agfStorageLaptopTakeAllButOne" sprite="ui_game_header_fill" defaultcolor="70,70,70" hovercolor="96,96,96" />
			</rect>
		</rect>
	</append>
</AGF-StorageLaptop>
