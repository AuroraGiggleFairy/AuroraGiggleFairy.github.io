<AGF-StorageLaptop>
	<append xpath="/blocks">
		<block name="cntStorageLaptop">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StorageLaptop.BlockStorageLaptop, StorageLaptop" />
			<property name="RequiredPower" value="5" />
			<property name="DescriptionKey" value="cntStorageLaptopDesc" />
			<property name="DisplayType" value="blockElectrical" />
			<property name="Material" value="Mmetal_weak" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Commercial/laptopOpenPrefab.prefab" />
			<property name="ModelOffset" value="0,0,0" />
			<property name="CustomIcon" value="decoLaptop" />
			<property name="GndAlign" value="1" />
			<property name="Place" value="TowardsPlacer" />
			<property name="OnlySimpleRotations" value="true" />
			<property name="ImposterDontBlock" value="true" />
			<property name="WaterFlow" value="permitted" />
			<property name="Path" value="solid" />
			<property name="HandleFace" value="South" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="StabilitySupport" value="false" />
			<property name="IsTerrainDecoration" value="true" />
