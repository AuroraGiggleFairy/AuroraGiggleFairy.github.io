<AGF-InventoryZoomTest>
	<conditional>
		<if cond="mod_loaded('AGF-1HUDPlus')">
			<set xpath="/windows/window[@name='windowAGFFeatures']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='details']/rect[@name='core']/rect[@name='body']/rect[@name='tabs']/rect[@name='tabsHeader']/grid[@name='tabButtons']/@rows">9</set>
			<append xpath="/windows/window[@name='windowAGFFeatures']/rect[@name='tabs']/rect[@name='tabsContents']/rect[@name='details']/rect[@name='core']/rect[@name='body']/rect[@name='tabs']/rect[@name='tabsContents']">
				<rect name="page_invzoom" controller="TabSelectorTab" tab_key="xuiAGFInvZoomTab">
					<label name="page_invzoom_title" depth="10" pos="550,-40" width="1100" height="80" justify="center" pivot="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[agfFeatPageTitleHV]" font_size="36" text_key="xuiAGFInvZoomTab" foregroundlayer="true"/>
					<rect name="page_invzoom_text" pos="217,-80" width="871" height="614" disableautobackground="true">
						<sprite name="page_invzoom_descFill" depth="3" pos="12,-12" sprite="ui_game_header_fill" color="[agfFeatBoxBgHV]" width="847" height="130" type="sliced" fillcenter="true" globalopacitymod="1.45"/>
						<sprite name="page_invzoom_descBorder" depth="4" pos="12,-12" sprite="menu_empty2px" color="[agfFeatBorderHV]" width="847" height="130" type="sliced" fillcenter="false"/>
						<label name="page_invzoom_descBody" depth="10" pos="28,-36" width="815" height="90" justify="left" pivot="topleft" overflow="clampcontent" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" foregroundlayer="true" color="[agfFeatPageBodyHV]" font_size="24" text_key="xuiAGFInvZoomBody"/>
						<sprite name="page_invzoom_settingsFill" depth="3" pos="12,-154" sprite="ui_game_header_fill" color="[agfFeatBoxBgHV]" width="847" height="120" type="sliced" fillcenter="true" globalopacitymod="1.45"/>
						<sprite name="page_invzoom_settingsBorder" depth="4" pos="12,-154" sprite="menu_empty2px" color="[agfFeatBorderHV]" width="847" height="120" type="sliced" fillcenter="false"/>
						<rect name="page_invzoom_options" controller="InventoryZoomPreset, InventoryZoomTest" depth="11" pos="12,-154" width="847" height="120" disableautobackground="true">
							<simplebutton name="btnPresetVanilla" pos="48,-42" depth="12" width="230" height="36" font_size="22" sprite="ui_game_header_fill" bordercolor="[agfFeatTabBorderHV]" defaultcolor="[agfFeatTabBgHV]" hovercolor="[agfFeatTabHoverHV]" selectedsprite="menu_empty" selectedcolor="[agfFeatTabSelectedHV]" selected="{invzoom_vanilla_selected}" caption_key="xuiAGFInvZoomVanilla" foregroundlayer="false" on_press="true"/>
							<simplebutton name="btnPreset10" pos="308,-42" depth="12" width="230" height="36" font_size="22" sprite="ui_game_header_fill" bordercolor="[agfFeatTabBorderHV]" defaultcolor="[agfFeatTabBgHV]" hovercolor="[agfFeatTabHoverHV]" selectedsprite="menu_empty" selectedcolor="[agfFeatTabSelectedHV]" selected="{invzoom_10_selected}" caption_key="xuiAGFInvZoom10" foregroundlayer="false" on_press="true"/>
							<simplebutton name="btnPreset12" pos="568,-42" depth="12" width="230" height="36" font_size="22" sprite="ui_game_header_fill" bordercolor="[agfFeatTabBorderHV]" defaultcolor="[agfFeatTabBgHV]" hovercolor="[agfFeatTabHoverHV]" selectedsprite="menu_empty" selectedcolor="[agfFeatTabSelectedHV]" selected="{invzoom_12_selected}" caption_key="xuiAGFInvZoom12" foregroundlayer="false" on_press="true"/>
						</rect>
					</rect>
				</rect>
			</append>
		</if>
	</conditional>
</AGF-InventoryZoomTest>
