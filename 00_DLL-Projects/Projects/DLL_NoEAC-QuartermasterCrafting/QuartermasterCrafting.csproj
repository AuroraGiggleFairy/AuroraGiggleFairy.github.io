<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>QuartermasterCrafting</RootNamespace>
    <AssemblyName>QuartermasterCrafting</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>.\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <SevenDaysToDieDir Condition="'$(SevenDaysToDieDir)'=='' and Exists('C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die\7DaysToDie.exe')">C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</SevenDaysToDieDir>
    <SevenDaysToDieDir Condition="'$(SevenDaysToDieDir)'=='' and Exists('C:\Program Files\Steam\steamapps\common\7 Days To Die\7DaysToDie.exe')">C:\Program Files\Steam\steamapps\common\7 Days To Die</SevenDaysToDieDir>
    <HarmonyDll Condition="Exists('$(SevenDaysToDieDir)\Mods\0_TFP_Harmony\0Harmony.dll')">$(SevenDaysToDieDir)\Mods\0_TFP_Harmony\0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)'==''">$(MSBuildProjectDirectory)\..\..\0_TFP_Harmony\0Harmony.dll</HarmonyDll>
    <DraftModDir>$(MSBuildProjectDirectory)\..\..\..\01_Draft\AGF-NoEAC-QuartermasterCrafting-v0.0.2</DraftModDir>
    <GameModDir>$(SevenDaysToDieDir)\Mods\AGF-NoEAC-QuartermasterCrafting-v0.0.2</GameModDir>
    <DedicatedModDir>C:\Program Files (x86)\Steam\steamapps\common\7 Days to Die Dedicated Server\Mods\AGF-NoEAC-QuartermasterCrafting-v0.0.2</DedicatedModDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyToDraft" AfterTargets="Build" Condition="Exists('$(DraftModDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DraftModDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyToGame" AfterTargets="CopyToDraft" Condition="Exists('$(DraftModDir)')">
    <ItemGroup>
      <DraftFiles Include="$(DraftModDir)\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(GameModDir)" />
    <Copy SourceFiles="@(DraftFiles)" DestinationFiles="@(DraftFiles->'$(GameModDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyToDedicated" AfterTargets="CopyToGame" Condition="Exists('$(DedicatedModDir)\..')">
    <ItemGroup>
      <DraftFilesDedicated Include="$(DraftModDir)\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(DedicatedModDir)" />
    <Copy SourceFiles="@(DraftFilesDedicated)" DestinationFiles="@(DraftFilesDedicated->'$(DedicatedModDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
