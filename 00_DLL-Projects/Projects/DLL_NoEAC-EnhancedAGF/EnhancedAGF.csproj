<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PlayerStatController</RootNamespace>
    <AssemblyName>EnhancedAGF</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <OutputPath>.\\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\LogLibrary.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="InControl">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\InControl.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NGUI">
      <HintPath>$(SevenDaysToDieDir)\7DaysToDie_Data\Managed\NGUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <ActiveBuildDir>$(MSBuildProjectDirectory)\..\..\..\02_ActiveBuild\AGF-NoEAC-EnhancedAGF-v4.3.4</ActiveBuildDir>
    <GameModDir>$(SevenDaysToDieDir)\Mods\AGF-NoEAC-EnhancedAGF-v4.3.4</GameModDir>
    <MainGameDir>C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</MainGameDir>
    <DoomTestHudDir>C:\Program Files (x86)\Steam\steamapps\common\7 Days to Die - Doom Test\Mods\zzz-FranticDansHUDbyAGF</DoomTestHudDir>
  </PropertyGroup>
  <Target Name="CopyToModFolders" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ActiveBuildDir)" SkipUnchangedFiles="false" Condition="Exists('$(ActiveBuildDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModDir)" SkipUnchangedFiles="false" Condition="Exists('$(GameModDir)')" />
    <!-- Same game build as the main install. DLL only, so the HUD mod's other files stay put. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DoomTestHudDir)" SkipUnchangedFiles="false" Condition="'$(SevenDaysToDieDir)' == '$(MainGameDir)' and Exists('$(DoomTestHudDir)\EnhancedAGF.dll')" />
    <Copy SourceFiles="$(ActiveBuildDir)\Config\Localization.csv" DestinationFolder="$(GameModDir)\Config" SkipUnchangedFiles="false" Condition="'$(SevenDaysToDieDir)' == '$(MainGameDir)' and Exists('$(ActiveBuildDir)\Config\Localization.csv')" />
    <Copy SourceFiles="$(ActiveBuildDir)\Config\XUi_InGame\windows.xml" DestinationFolder="$(GameModDir)\Config\XUi_InGame" SkipUnchangedFiles="false" Condition="'$(SevenDaysToDieDir)' == '$(MainGameDir)' and Exists('$(ActiveBuildDir)\Config\XUi_InGame\windows.xml')" />
  </Target>
</Project>