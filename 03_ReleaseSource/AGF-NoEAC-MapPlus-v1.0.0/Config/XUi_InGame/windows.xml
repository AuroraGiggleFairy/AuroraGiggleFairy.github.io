<AGF-MapPlus>
	<append xpath="/windows/window[@name='mapArea']/rect[@name='header']">
		<label name="poiName" depth="3" pos="200,-6" width="250" height="32" text="{mapplusname}" font_size="32" justify="center" color="255,153,0,255" overflow="shrinkcontent" />
	</append>
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-1Main')">
			<set xpath="/windows/window[@name='mapArea']/rect[@name='header']/label[@name='poiName']/@pos">160,-6</set>
			<set xpath="/windows/window[@name='mapArea']/rect[@name='header']/label[@name='poiName']/@width">398</set>
		</if>
	</conditional>
	<append xpath="/windows/window[@name='mapArea']/rect[@name='content']/rect[@name='mapView']">
		<sprite name="poiBoundsFill" depth="6" sprite="menu_empty" color="255,153,0,50" type="sliced" visible="false" />
		<sprite name="poiBoundsOuter" depth="7" sprite="menu_empty3px" color="255,153,0,255" type="sliced" fillcenter="false" visible="false" />
		<sprite name="poiBounds" depth="8" sprite="menu_empty3px" color="255,153,0,255" type="sliced" fillcenter="false" visible="false" />
	</append>
</AGF-MapPlus>
