<config>


	<conditional>
		<if cond="game_version() &gt;= version(1,3,30) and mod_loaded('AGF-VP-LargerStorageOption')">
			<append xpath="/lootcontainers">
				<!-- PLAYER cntSortingCart. 3.3 is 8 wide so the loot window can scroll the extra rows. 8 x 21 = 168, same count as the old 12 x 14. -->
				<lootcontainer name="playerSortingCart" count="0" size="8,21" sound_open="UseActions/crate_iron_open" sound_close="UseActions/crate_iron_close" loot_quality_template="qualBaseTemplate">
					<item name="cobweb" count="0" />
				</lootcontainer>
			</append>
		</if>
		<if cond="game_version() &gt;= version(1,3,30)">
			<append xpath="/lootcontainers">
				<!-- PLAYER cntSortingCart. 8 x 12 = 96. -->
				<lootcontainer name="playerSortingCart" count="0" size="8,12" sound_open="UseActions/crate_iron_open" sound_close="UseActions/crate_iron_close" loot_quality_template="qualBaseTemplate">
					<item name="cobweb" count="0" />
				</lootcontainer>
			</append>
		</if>
		<if cond="mod_loaded('AGF-VP-LargerStorageOption')">
			<append xpath="/lootcontainers">
				<!-- PLAYER cntSortingCart-->
				<lootcontainer name="playerSortingCart" count="0" size="12,14" sound_open="UseActions/crate_iron_open" sound_close="UseActions/crate_iron_close" loot_quality_template="qualBaseTemplate">
					<item name="cobweb" count="0" />
				</lootcontainer>
			</append>
		</if>
		<else>
			<append xpath="/lootcontainers">
				<!-- PLAYER cntSortingCart-->
				<lootcontainer name="playerSortingCart" count="0" size="9,10" sound_open="UseActions/crate_iron_open" sound_close="UseActions/crate_iron_close" loot_quality_template="qualBaseTemplate">
					<item name="cobweb" count="0" />
				</lootcontainer>
			</append>
		</else>
	</conditional>

		
	
</config>
