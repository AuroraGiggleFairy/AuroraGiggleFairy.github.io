<?xml version="1.0" encoding="UTF-8"?>
<AGF-LawnTractorV3Fix>

	<!-- Vanilla vehicle bars: icons sit left of the fuel and durability stack. -->
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-1Main') == false">
			<append xpath="/windows/window[@name='HUDRightStatBars']/rect[@name='hud'][@pos='-177,106']/rect[@stat_type='VehicleFuel']">
				<sprite depth="8" name="ocbTractorLights" sprite="ui_game_symbol_lightbulb" size="30,30" pos="-18,-28" pivot="center" color="245,245,245,255" visible="{ocbTractorLightsOn}" foregroundlayer="true" tooltip="Lights"/>
				<sprite depth="8" name="ocbTractorMowing" sprite="ui_game_symbol_foliage" size="30,30" pos="-18,-68" pivot="center" color="245,245,245,255" visible="{ocbTractorMowingOn}" foregroundlayer="true" tooltip="Mowing"/>
			</append>
		</if>
	</conditional>

	<!-- HUD only: two status icons just left of the vehicle cluster. -->
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-1Main') and mod_loaded('AGF-NoEAC-EnhancedAGF') == false">
			<append xpath="/windows/window[@name='HUDRightStatBars']/rect[@name='vehicleStatsBase']">
				<sprite depth="8" name="ocbTractorLights" sprite="ui_game_symbol_lightbulb" size="30,30" pos="-18,-28" pivot="center" color="245,245,245,255" visible="{ocbTractorLightsOn}" foregroundlayer="true" tooltip="Lights"/>
				<sprite depth="8" name="ocbTractorMowing" sprite="ui_game_symbol_foliage" size="30,30" pos="-18,-68" pivot="center" color="245,245,245,255" visible="{ocbTractorMowingOn}" foregroundlayer="true" tooltip="Mowing"/>
			</append>
		</if>
	</conditional>

	<!-- HUD + EnhancedAGF: the extra panel is the leftmost vehicle display, so the icons sit left of that. -->
	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-1Main') and mod_loaded('AGF-NoEAC-EnhancedAGF')">
			<append xpath="/windows/window[@name='HUDRightStatBars']/rect[@name='vehicleAuxPanelAGF']">
				<sprite depth="8" name="ocbTractorLights" sprite="ui_game_symbol_lightbulb" size="30,30" pos="-18,-28" pivot="center" color="245,245,245,255" visible="{ocbTractorLightsOn}" foregroundlayer="true" tooltip="Lights"/>
				<sprite depth="8" name="ocbTractorMowing" sprite="ui_game_symbol_foliage" size="30,30" pos="-18,-68" pivot="center" color="245,245,245,255" visible="{ocbTractorMowingOn}" foregroundlayer="true" tooltip="Mowing"/>
			</append>
		</if>
	</conditional>

</AGF-LawnTractorV3Fix>
