<zzzAGF-Compatibilities>
	<!-- Re-apply AGF pack mule / almanac / night stalker carry without vanilla 3,6,10,14,18 or 45/27 filters. -->
	<conditional>
		<if cond="mod_loaded('AGF-BackpackPlus-119Slots')">
			<set xpath="/progression/perks/perk[@name='perkPackMule']/effect_group/passive_effect[@name='CarryCapacity']/@value">15,30,45,61,77</set>
			<set xpath="/progression/perks/book[@name='perkFiremansAlmanacComplete']/effect_group/passive_effect[@name='CarryCapacity']/@value">119</set>
			<set xpath="/progression/perks/book[@name='perkNightStalkerThiefAdrenaline']/effect_group/passive_effect[@name='CarryCapacity']/@value">119</set>
		</if>
		<else>
			<conditional>
				<if cond="mod_loaded('AGF-BackpackPlus-084Slots')">
					<set xpath="/progression/perks/perk[@name='perkPackMule']/effect_group/passive_effect[@name='CarryCapacity']/@value">9,18,28,38,48</set>
					<set xpath="/progression/perks/book[@name='perkFiremansAlmanacComplete']/effect_group/passive_effect[@name='CarryCapacity']/@value">84</set>
					<set xpath="/progression/perks/book[@name='perkNightStalkerThiefAdrenaline']/effect_group/passive_effect[@name='CarryCapacity']/@value">48</set>
				</if>
				<else>
					<conditional>
						<if cond="mod_loaded('AGF-BackpackPlus-072Slots')">
							<set xpath="/progression/perks/perk[@name='perkPackMule']/effect_group/passive_effect[@name='CarryCapacity']/@value">7,14,21,28,36</set>
							<set xpath="/progression/perks/book[@name='perkFiremansAlmanacComplete']/effect_group/passive_effect[@name='CarryCapacity']/@value">72</set>
							<set xpath="/progression/perks/book[@name='perkNightStalkerThiefAdrenaline']/effect_group/passive_effect[@name='CarryCapacity']/@value">72</set>
						</if>
						<else>
							<conditional>
								<if cond="mod_loaded('AGF-BackpackPlus-060Slots')">
									<set xpath="/progression/perks/perk[@name='perkPackMule']/effect_group/passive_effect[@name='CarryCapacity']/@value">6,12,18,24,30</set>
									<set xpath="/progression/perks/book[@name='perkFiremansAlmanacComplete']/effect_group/passive_effect[@name='CarryCapacity']/@value">60</set>
									<set xpath="/progression/perks/book[@name='perkNightStalkerThiefAdrenaline']/effect_group/passive_effect[@name='CarryCapacity']/@value">60</set>
								</if>
							</conditional>
						</else>
					</conditional>
				</else>
			</conditional>
		</else>
	</conditional>
</zzzAGF-Compatibilities>
