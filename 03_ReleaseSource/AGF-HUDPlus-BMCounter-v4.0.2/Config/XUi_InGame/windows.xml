<AGF-HUDPlus-BMCounter>

	<conditional>
		<if cond="mod_loaded('AGF-HUDPlus-1Main')">
			<append xpath="/windows/window[@name='windowCompass']">
				<rect name="counterBM" pos="70,-53" width="380">
					<label depth="3" pos="0,-4" text="{# localization('agfNextBloodMoon')}:   [{daycolor}]{# max(0, gamestat('BloodMoonDay') - day) == 0 ? localization('agfBloodMoonTonight') : max(0, gamestat('BloodMoonDay') - day)}[-]" width="380" style="outline" font_size="22" justify="center" height="24" visible="{showtime}"/>
				</rect>
			</append>
		</if>
		<else>
			<!-- Vanilla compass is 480 wide; time row sits at y=-60 (28px, pivot center). Counter is 380 wide, centered, just under that row. -->
			<append xpath="/windows/window[@name='windowCompass']">
				<rect name="counterBM" pos="50,-90" width="380">
					<label depth="3" pos="0,0" text="{# localization('agfNextBloodMoon')}:   [{daycolor}]{# max(0, gamestat('BloodMoonDay') - day) == 0 ? localization('agfBloodMoonTonight') : max(0, gamestat('BloodMoonDay') - day)}[-]" width="380" style="outline" font_size="22" justify="center" height="24" visible="{showtime}"/>
				</rect>
			</append>
			<set xpath="/windows/window[@name='windowTargetBar']/rect[@pos='-200,-85']/@pos">-200,-120</set>
			<set xpath="/windows/window[@name='windowTargetBar']/rect[@pos='-267,-85']/@pos">-267,-120</set>
		</else>
	</conditional>


</AGF-HUDPlus-BMCounter>
